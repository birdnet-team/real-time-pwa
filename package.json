{
  "name": "real-time-pwa",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "fetch-models": "node scripts/fetch-models.mjs",
    "prebuild": "npm run fetch-models",
    "build": "eleventy",
    "preserve": "npm run fetch-models",
    "serve": "eleventy --serve --port=8080",
    "prewatch": "npm run fetch-models",
